# Copy this file to .env. Leave real credentials out of source control.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
# Optional authenticated GitHub reads; public requests also work without it.
GITHUB_TOKEN=
# NVIDIA's provider key belongs in Nightshift Providers, not in this file.
